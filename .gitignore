dist/
desktop/dist/
*.blockmap

# ---- 日志 ----
*.log
npm-debug.log*
yarn-error.log*

# ---- WorkBuddy 本机工具产物（与项目无关）----
.workbuddy/
*.genie

# ---- 操作系统杂项 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.swp
